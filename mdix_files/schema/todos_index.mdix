// Brought to u by MidManStudio

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  features   -> "quickfuncs,data,imports"
  debug_mode -> "off"
)

@IMPORTS(
  Themes from "themes.mdix"
)

@QUICKFUNCS(

  // See notes_index.mdix's comment on isPinned/headerTheme/bodyTheme/
  // icon/reminder — same reasoning, same fields, todos side.
  ~todo_ref<object>(_id, _title, _tags, _lastModified, _isBookmarked, _encrypted, _isPinned, _headerTheme<object>, _bodyTheme<object>, _icon, _reminder) {
    return {
      id           = _id
      title        = _title
      tags         = _tags
      lastModified = _lastModified
      isBookmarked = _isBookmarked
      encrypted    = _encrypted
      isPinned     = _isPinned
      headerTheme  = _headerTheme
      bodyTheme    = _bodyTheme
      icon         = _icon
      reminder     = _reminder
    }
  }

)

@DATA(
  todos::
    todo_ref("r1", "Grandma's Chili", ["dinner", "comfort-food"], 2026-08-07T18:30:00Z, true, false, false, Themes.theme_preset("sunset"), Themes.theme_preset("none"), null, null)
)
