@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  features   -> "quickfuncs,data"
  debug_mode -> "off"
)

@QUICKFUNCS(

  // See notes_index.mdix's comment on the same two added fields.
  ~todo_ref<object>(id, title, tags, lastModified, isBookmarked, encrypted, theme, reminder) {
    return {
      id           = id
      title        = title
      tags         = tags
      lastModified = lastModified
      isBookmarked = isBookmarked
      encrypted    = encrypted
      theme        = theme
      reminder     = reminder
    }
  }

)

@DATA(
  todos::
    todo_ref("r1", "Grandma's Chili", ["dinner", "comfort-food"], "2026-08-07T18:30:00Z", true, false, "none", "")
)
