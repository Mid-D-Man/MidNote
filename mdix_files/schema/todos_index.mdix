// Brought to u by MidManStudio

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  features   -> "quickfuncs,data,imports"
  debug_mode -> "off"
)

@IMPORTS(
  Themes from "themes.mdix"
)

@QUICKFUNCS(

  // See notes_index.mdix's comment on the same two added fields.
  ~todo_ref<object>(_id, _title, _tags, _lastModified, _isBookmarked, _encrypted, _theme<object>, _reminder) {
    return {
      id           = _id
      title        = _title
      tags         = _tags
      lastModified = _lastModified
      isBookmarked = _isBookmarked
      encrypted    = _encrypted
      theme        = _theme
      reminder     = _reminder
    }
  }

)

@DATA(
  todos::
    todo_ref("r1", "Grandma's Chili", ["dinner", "comfort-food"], 2026-08-07T18:30:00Z, true, false, Themes.theme_preset("sunset"), null)
)
