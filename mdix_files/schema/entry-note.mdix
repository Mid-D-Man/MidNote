// Brought to u by MidManStudio

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  features   -> "data,enums,imports,quickfuncs"
  debug_mode -> "off"
)

@ENUMS(
  EntryType { REGULAR, TODO }
)

@IMPORTS(
  Themes from "themes.mdix"
)

@QUICKFUNCS(

  ~note_page<object>(_id, _content, _name) {
    return {
      id      = _id
      content = _content
      name    = _name
    }
  }

)

@DATA(
  id           = "n1"
  type<enum>   = EntryType.REGULAR
  title        = "Grocery list"
  content      = "Milk, eggs, bread, coffee"
  // New: page 1 (content, above) can be renamed just like any other
  // page — see PagesPanel.svelte. null means auto-numbered ("Page 1"),
  // same null-means-default convention as icon/reminder below.
  page1Name    = null
  lastModified = 2026-08-08T09:15:00Z
  isBookmarked = false
  // Was already a field on EntryRef/notes_index.mdix's note_ref before
  // this, but had no home in the full entry schema's own @DATA sample
  // — adding it now since it's finally directly relevant (see the Lock
  // trio right below, which are meaningless without it).
  encrypted    = false

  // ⋮ overflow menu — pinned entries float to the top of the browse
  // list (see +page.svelte's sortedItems), suspended while the search
  // box has text in it. Same field name/shape on notes and todos.
  isPinned     = false

  // REVISION: was a single `theme` field — split into independent
  // header/body slots (see ThemeSectionsSheet.svelte). headerTheme is
  // exactly what the old flat `theme` field meant (the card in the
  // list, and the editor's own top bar); bodyTheme is new — the actual
  // writing surface's own background, painted behind a near-opaque text
  // panel rather than directly under live Tiptap caret/selection
  // rendering (see note/[id]/+page.svelte's .inner-panel). Both resolve
  // through the same Themes.theme_preset()/theme_custom() pointer shape
  // — nothing about resolving a theme reference changed, only how many
  // of them one entry carries.
  headerTheme  = Themes.theme_preset("sunset")
  bodyTheme    = Themes.theme_preset("none")

  // New: a small glyph badge shown next to the title on this note's
  // card (see themePalette.ts's ICON_PRESETS) — a plain preset name, not
  // an object, since there's nothing to resolve beyond a lookup against
  // a fixed curated list. null means no icon set, same "real value in
  // this sample vs null in reminder below" distinction as headerTheme
  // above.
  icon         = "idea"
  reminder     = null

  // Lock — real DixScript-Rust encryption via
  // src-tauri/src/data/crypto.rs (AES-256-GCM, Argon2id-derived key
  // from a password — the same mechanism dixscript's own CLI uses for
  // "encrypted secrets bundle" configs, not a hand-rolled cipher).
  // Deliberately NOT in notes_index.mdix/todos_index.mdix: the index is
  // a lightweight list-view row, and lockedPayload/lockedKeyFile can be
  // arbitrarily large — the list only ever needs `encrypted` (above) to
  // know whether to show a lock icon, never these three. null/null/null
  // when not locked; when locked, `content` and `pages` above move
  // inside the encrypted payload instead, restored on unlock — see
  // utils/lockFlow.ts. REVISION: tags do NOT move into the payload
  // anymore and are NOT cleared on lock — they stay visible on a locked
  // card (genuinely useful for finding/organizing a locked note without
  // unlocking it; they aren't sensitive the way the note's body is). A
  // note previously locked under the old scheme still round-trips
  // correctly — see lockFlow.ts's applyDecryptedPayload for the
  // backward-compat path.
  lockKeyMode   = null
  lockedPayload = null
  lockedKeyFile = null

  tags::
    "personal"

  // New: additional pages beyond this note's own `content` field above,
  // which always stays "page 1" (see entry.ts's Note.pages comment for
  // why it wasn't folded into one pages array covering everything).
  // Empty here would mean "just the one page" — this sample has a
  // second, to actually exercise the field. Third argument is the
  // page's own optional custom name (null = auto-numbered "Page 2").
  pages::
    note_page("n1p2", "Also need: paper towels, dish soap", null)
)
