@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  features   -> "data,enums"
  debug_mode -> "off"
)

@ENUMS(
  EntryType { REGULAR, TODO }
)

@DATA(
  id           = "n1"
  type<enum>   = EntryType.REGULAR
  title        = "Grocery list"
  content      = "Milk, eggs, bread, coffee"
  lastModified = "2026-08-08T09:15:00Z"
  isBookmarked = false

  // Not wired up yet — schema-only placeholders for the future actions
  // menu (theme/favorite/lock/reminder). Favorite and lock already have
  // homes above (isBookmarked, encrypted); theme and reminder are the
  // two genuinely new fields. theme is a loose string identifier rather
  // than a defined @ENUMS set on purpose — the actual palette/categories
  // (see the Theme & Color reference material) are a real design
  // decision for whoever builds the actions menu, not something to lock
  // in from a schema pass alone. reminder is an empty string for "none
  // set," otherwise an ISO 8601 datetime — same shape as lastModified,
  // so no separate "hasReminder" flag is needed.
  theme        = "none"
  reminder     = ""

  tags::
    "personal"
)
