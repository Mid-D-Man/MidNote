// Brought to u by MidManStudio

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  features   -> "quickfuncs,data,enums,imports"
  debug_mode -> "off"
)

@ENUMS(
  EntryType { REGULAR, TODO, BOARD }
)

@IMPORTS(
  Themes from "themes.mdix"
)

@QUICKFUNCS(

  ~step<object>(_id, _category, _title, _content) {
    return {
      id       = _id
      category = _category
      title    = _title
      content  = _content
    }
  }

  ~annotation<object>(_id, _category, _title, _content) {
    return {
      id       = _id
      category = _category
      title    = _title
      content  = _content
    }
  }

)

@DATA(
  id           = "r1"
  type<enum>   = EntryType.TODO
  title        = "Grandma's Chili"
  lastModified = 2026-08-07T18:30:00Z
  isBookmarked = true
  encrypted    = false

  // See entry-note.mdix's comment on this same trio of fields —
  // identical shape and identical reasoning here.
  isPinned     = false
  // REVISION: see entry-note.mdix's identical headerTheme/bodyTheme
  // comment — same split, same reasoning, todos side. No pages field
  // here: that's a notes-only concept (see entry.ts's Note.pages
  // comment) — a todo's actual content is its steps/annotations below,
  // which already have their own category-based organization.
  headerTheme  = Themes.theme_preset("sunset")
  bodyTheme    = Themes.theme_preset("none")
  icon         = null
  reminder     = null

  // See entry-note.mdix's comment on this same trio. On a todo,
  // steps/annotations (not tags) move into the encrypted payload when
  // locked — see utils/lockFlow.ts's buildPlaintextPayload. REVISION:
  // tags do NOT move into the payload anymore and are NOT cleared on
  // lock — see entry-note.mdix's identical note on this same change.
  lockKeyMode   = null
  lockedPayload = null
  lockedKeyFile = null

  tags::
    "dinner", "comfort-food"

  categories::
    "Ingredients", "Steps"

  steps::
    step("s1", "Ingredients", "Base", "2 lbs ground beef, 1 onion diced, 2 cans kidney beans"),
    step("s2", "Steps", "Brown the meat", "Heat oil, add beef and onion, cook until browned")

  annotations::
    annotation("a1", "Tips", "Make ahead", "Tastes better the next day")
)
