@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  features   -> "quickfuncs,data,enums,imports"
  debug_mode -> "off"
)

@ENUMS(
  EntryType { REGULAR, TODO }
)

@IMPORTS(
  Themes from "themes.mdix"
)

@QUICKFUNCS(

  ~step<object>(_id, _category, _title, _content) {
    return {
      id       = _id
      category = _category
      title    = _title
      content  = _content
    }
  }

  ~annotation<object>(_id, _category, _title, _content) {
    return {
      id       = _id
      category = _category
      title    = _title
      content  = _content
    }
  }

)

@DATA(
  id           = "r1"
  type<enum>   = EntryType.TODO
  title        = "Grandma's Chili"
  lastModified = 2026-08-07T18:30:00Z
  isBookmarked = true

  // Not wired up yet — see entry-note.mdix's comment on this same pair
  // of fields; identical shape and identical reasoning here.
  theme        = Themes.theme_preset("sunset")
  reminder     = null

  tags::
    "dinner", "comfort-food"

  categories::
    "Ingredients", "Steps"

  steps::
    step("s1", "Ingredients", "Base", "2 lbs ground beef, 1 onion diced, 2 cans kidney beans"),
    step("s2", "Steps", "Brown the meat", "Heat oil, add beef and onion, cook until browned")

  annotations::
    annotation("a1", "Tips", "Make ahead", "Tastes better the next day")
)
